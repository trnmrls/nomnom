<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your delicious diary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Every bite has a story worth remembering."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>

        <!-- SEARCH BAR -->
        <EditText
            android:id="@+id/searchMeals"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/journal_input_bg"
            android:hint="Search your food memories..."
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"/>

        <!-- MEAL CATEGORY FILTERS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary"/>

                <Button
                    android:id="@+id/filterBreakfast"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Breakfast"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_peach"/>

                <Button
                    android:id="@+id/filterLunch"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Lunch"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_peach"/>

                <Button
                    android:id="@+id/filterDinner"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Dinner"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_peach"/>

                <Button
                    android:id="@+id/filterSnack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Snack"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_peach"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ADD ENTRY BUTTON -->
        <Button
            android:id="@+id/addMealButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="+ Add Entry"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"/>

        <!-- JOURNAL SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="More from your journal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="A collection of your favorite food moments."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"/>

        <!-- REUSABLE FOOD CARDS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/foodRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"/>

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/emptyJournalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="44sp"
                android:textColor="@color/primary"/>

            <TextView
                android:id="@+id/emptyJournalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No entry found"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"/>

            <TextView
                android:id="@+id/emptyJournalDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your next delicious memory is waiting!"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"/>

        </LinearLayout>


        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Made with love, one bite at a time."
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
